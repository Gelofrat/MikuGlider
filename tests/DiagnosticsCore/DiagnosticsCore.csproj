<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0649</NoWarn>
    <ManagedRoot>$(MikuGliderGameRoot)/Mycopunk_Data/Managed</ManagedRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="RegressionChecks.cs" />
    <Compile Include="RecordingChecks.cs" />
    <Compile Include="../../diagnostics/src/Analysis/SurfaceGeometry.cs" />
    <Compile Include="../../diagnostics/src/Data/*.cs" />
    <Compile Include="../../diagnostics/src/Geometry/GeometryMath.cs" />
    <Compile Include="../../diagnostics/src/Geometry/PointIndex.cs" />
    <Compile Include="../../diagnostics/src/Geometry/TriangleIndex.cs" />
    <Compile Include="../../diagnostics/src/Geometry/ParticleSpace.cs" />
    <Compile Include="../../diagnostics/src/Geometry/ClothVertexMapping.cs" />
    <Compile Include="../../diagnostics/src/Analysis/ParticleMotion.cs" />
    <Compile Include="../../diagnostics/src/Recording/CaptureSession.cs" />
    <Compile Include="../../diagnostics/src/Control/LocalControl.cs" />
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedRoot)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ManagedRoot)/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
